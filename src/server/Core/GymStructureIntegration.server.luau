--[[ This script analyzes the real GymStructure in the workspace, instead of using the GymStructureJSON.
-- This script reads the real Gym Structure in the workspace, checks if everything is correct, and gives a detailed report of the errors. It can also generate the GymStructureJSON data.]]

--[[
    GymStructureIntegration.server.luau
    
    This script reads the GymStructureJSON data from ServerStorage (generated by AnalyzeGymStructure)
    and integrates it with the BuyTileSystem. It ensures that the prerequisites in the BuyTileSystem
    match the actual physical structure of the gym.
    
    Author: Created April 20, 2025
]]

local ServerStorage = game:GetService("ServerStorage")
local HttpService = game:GetService("HttpService")
local workspace = game:GetService("Workspace")

-- Try to get the CoreRegistry
local CoreRegistry = require(script.Parent:FindFirstChild("CoreRegistry") or {})

local GymStructureIntegration = {}
GymStructureIntegration.__index = GymStructureIntegration

-- Initialize the integration
function GymStructureIntegration:Initialize()
    print("GymStructureIntegration: Initializing...")
    
    -- Register with CoreRegistry if available
    if CoreRegistry and CoreRegistry.RegisterSystem then
		if not _G.GenerateGymStructureJSON then
			_G.GenerateGymStructureJSON = function()
				if self.GenerateGymStructureJSON then
					return self:GenerateGymStructureJSON()
				else
					warn("GenerateGymStructureJSON method not found")
				end
			end
		end

        CoreRegistry:RegisterSystem("GymStructureIntegration", self)
    end
    
    -- Get references to required systems
    self.buyTileSystem = CoreRegistry and CoreRegistry:GetSystem("BuyTileSystem")
    
    -- Log a warning if BuyTileSystem isn't found
    if not self.buyTileSystem then
        warn("GymStructureIntegration: BuyTileSystem not found. Some features may not work properly.")
    end
    
    -- Process the gym structure data
    self:ProcessGymStructureData()
    
    return self
end

-- Load the gym structure data from ServerStorage
function GymStructureIntegration:LoadGymStructureData()
    local gymStructureJSON = ServerStorage:FindFirstChild("GymStructureJSON")
    
    if not gymStructureJSON then
        warn("GymStructureIntegration: GymStructureJSON not found in ServerStorage")
		local structure = self:AnalyzeGymStructure(false)
		if structure then
			warn("GymStructureIntegration: Trying to generate a new GymStructureJSON")
			self:GenerateGymStructureJSON()
			return self:LoadGymStructureData()
		end
        return nil
    end
    
    -- Attempt to decode the JSON
    local success, structure = pcall(function()
        return HttpService:JSONDecode(gymStructureJSON.Value)
    end)
    
    if not success or not structure then
        warn("GymStructureIntegration: Failed to decode GymStructureJSON")
        return nil
    end
    
    return structure
end

-- Process the gym structure data and integrate it with BuyTileSystem
function GymStructureIntegration:ProcessGymStructureData()
    local structure = self:LoadGymStructureData()
    if not structure then return end
    
    print("GymStructureIntegration: Successfully loaded gym structure data")
    
    -- Store the full structure for reference
    self.gymStructure = structure
    
    -- Integrate floor prerequisites with BuyTileSystem
    if self.buyTileSystem then self:IntegrateDataWithBuyTileSystem() end
end

--[[
	This function will analyze the real gym structure in the workspace, instead of using the GymStructureJSON.
	This function will have as a first step a print of "Analyzing Gym Structure..." and another one saying "Gym Structure analysis finished."
]]

function GymStructureIntegration:AnalyzeGymStructure(verbose)
	print("Analyzing Gym Structure...")
	local gymParts = workspace:FindFirstChild("GymParts")
	if not gymParts then
		warn("GymStructureIntegration: GymParts folder not found in workspace.")
		return nil
	end

	local structure = {}    
	local validation = {}
	local function processChild(child, parentStructure)
        local childData = {
            type = child:IsA("Folder") and "Folder" or (child:IsA("BasePart") and "Part" or "Model"),
            attributes = {}
        }
        
        -- Get attributes
        for _, attributeName in ipairs(child:GetAttributeNames()) do
            childData.attributes[attributeName] = child:GetAttribute(attributeName)
        end

        --Check for specific attributes
        if child:GetAttribute("Category") then childData.attributes["Category"] = child:GetAttribute("Category") end
        if child:GetAttribute("Room") then childData.attributes["Room"] = child:GetAttribute("Room") end
        if child:GetAttribute("Floor") then childData.attributes["Floor"] = child:GetAttribute("Floor") end
        if child:GetAttribute("FloorName") then childData.attributes["FloorName"] = child:GetAttribute("FloorName") end

		-- Add default values
		childData.isValid = true
		childData.validation = {}
        parentStructure[child.Name] = childData

        if child:IsA("Folder") then
            childData.children = {}
            for _, subChild in ipairs(child:GetChildren()) do
                processChild(subChild, childData.children)
			end
		end

		-- Validation Checks
		local requiredAttributes = {}
		if childData.type == "Model" then
			requiredAttributes = {"Category", "Room", "Floor", "FloorName"}
		end
		for _, attribute in ipairs(requiredAttributes) do
			if not childData.attributes[attribute] then
				childData.isValid = false
				table.insert(childData.validation, "Missing required attribute: " .. attribute)
			end
		end

		-- Check for correct build order (example)
		if childData.attributes.buildOrder then
			local buildOrder = childData.attributes.buildOrder
			if type(buildOrder) ~= "number" or buildOrder < 1 then
				childData.isValid = false
				table.insert(childData.validation, "Invalid buildOrder: " .. tostring(buildOrder))
			end
		end

		-- Check for prerequisites (example)
		if childData.attributes.prerequisites then
			-- Check if the prerequisites exist
			-- ...
			--if a prerequisite is not found
			--childData.isValid = false
			--table.insert(childData.validation, "Missing prerequisite: " .. tostring(aPrerequisite))
		end

		-- Check for gateways (example)
		if childData.attributes.unlocksFloor then
			--check if the next floor exists.
			if not childData.attributes["Floor"] then
				childData.isValid = false
				table.insert(childData.validation, "Gateway must have a floor attribute")
            end
        end
    end
    for _, child in ipairs(gymParts:GetChildren()) do
        processChild(child, structure)
    end
	print("Gym Structure analysis finished.")

	structure.validation = validation

	return structure
end

--[[
    Generates a report based on the analyzed gym structure.
    
    This function recursively traverses the structure and prints
    information about each element, including its validity status
    and any validation errors.
]]
local function GenerateReport(structure)
    local allValid = true
    local function processElement(element, name)
        local elementType = element.type
        print(elementType .. ": " .. name .. (element.isValid and " (Valid)" or " (Invalid)"))
        if not element.isValid then
            allValid = false
            warn("  Validation Errors: " .. table.concat(element.validation, ", "))
        end
        if element.children then for childName, childData in pairs(element.children) do processElement(childData, childName) end end
    end
    for name, data in pairs(structure) do if name ~= "validation" then processElement(data, name) end end
    return allValid
end

-- Integrate gym structure data with BuyTileSystem
function GymStructureIntegration:IntegrateDataWithBuyTileSystem()
    if not self.gymStructure then return end
    
    local buyTileSystem = self.buyTileSystem
    
    -- Integrate floors and room unlocks
    if self.gymStructure.floors then
        for floorNumber, floorData in pairs(self.gymStructure.floors) do
            floorNumber = tonumber(floorNumber)
            if not floorNumber then continue end
            
            local floorName = floorData.name
            local rooms = floorData.rooms
            
            print("Integrating floor " .. floorNumber .. " (" .. floorName .. ")")
            
            -- Integrate individual rooms on this floor
            for roomName, roomData in pairs(rooms) do
                self:IntegrateRoomData(floorNumber, roomName, roomData)
            end
            
            -- Example: Check and update floor unlock requirements in BuyTileSystem
            if floorData.unlockRequirement then
                local requiredFloor = floorData.unlockRequirement.floor
                local unlockItem = buyTileSystem.floorUnlockItems[floorNumber]
                
                if unlockItem and buyTileSystem.tileData[unlockItem] then
                    print("Floor " .. floorNumber .. " unlock requirement: Floor " .. requiredFloor .. " (Unlocked by " .. unlockItem .. ")")
                    -- Update BuyTileSystem as needed (Example: Update a dictionary)
                else
                    warn("Unlock item for floor " .. floorNumber .. " not found or missing data in BuyTileSystem")
                end
            end
        end
    end
end

-- Integrate data for a specific room
function GymStructureIntegration:IntegrateRoomData(floorNumber, roomName, roomData)
    local buyTileSystem = self.buyTileSystem
    
    print("  Integrating room: " .. roomName .. " on floor " .. floorNumber)
    
    -- Example: Map room names to tile types or IDs in BuyTileSystem
    local tileType = self:FindMatchingTileType(floorNumber, roomName)
    if tileType then
        print("    Room '" .. roomName .. "' matches tile type '" .. tileType .. "'")
        -- Could update BuyTileSystem or other systems with this match
    else
        warn("    Room '" .. roomName .. "' on floor " .. floorNumber .. " has no matching tile in BuyTileSystem")
        -- Could suggest adding a new tile type for this room
    end
    
    -- Integrate zones within the room (if applicable)
    if roomData.zones then
        for zoneName, zoneData in pairs(roomData.zones) do
            print("    Integrating zone: " .. zoneName .. " in room " .. roomName)
            -- Process zone data and integrate as needed
        end
    end
end

-- Find a matching tile type in BuyTileSystem
function GymStructureIntegration:FindMatchingTileType(floorNumber, roomName)
    if not self.buyTileSystem or not self.buyTileSystem.tileData then return nil end
    
    local buyTileSystem = self.buyTileSystem
    local normalizedRoomName = roomName:lower():gsub("%s+", "")
    
    for tileType, tileData in pairs(buyTileSystem.tileData) do
        if tileData.floor == floorNumber then
            local description = tileData.description or ""
            if description:lower():find(normalizedRoomName, 1, true) or tileType:lower():find(normalizedRoomName, 1, true) then
                return tileType
            end
        end
    end
    
    return nil -- No matching tile type found
end

-- Get a list of all room names
function GymStructureIntegration:GetRoomNames()
    if not self.gymStructure or not self.gymStructure.floors then return {} end
    
    local roomNames = {}
    
    for _, floorData in pairs(self.gymStructure.floors) do
        if floorData.rooms then
            for roomName, _ in pairs(floorData.rooms) do
                table.insert(roomNames, roomName)
            end
        end
    end
    
    return roomNames
end

-- Get the name of a specific floor
function GymStructureIntegration:GetFloorName(floorNumber)
    if not self.gymStructure or not self.gymStructure.floors[floorNumber] then return nil end
    
    return self.gymStructure.floors[floorNumber].name
end

-- Get the structure data for a specific room
function GymStructureIntegration:GetRoomData(floorNumber, roomName)
    if not self.gymStructure or not self.gymStructure.floors[floorNumber] or not self.gymStructure.floors[floorNumber].rooms[roomName] then return nil end
    
    return self.gymStructure.floors[floorNumber].rooms[roomName]
end

-- Get a mapping of all rooms to floor numbers
function GymStructureIntegration:GetRoomFloorMapping()
    if not self.gymStructure or not self.gymStructure.roomTypes then return {} end
    
    local mapping = {}
    
    for floorNumber, floorData in pairs(self.gymStructure.floors) do
        if floorData.rooms then
            for roomName, _ in pairs(floorData.rooms) do
                mapping[roomName] = mapping[roomName] or {}
                table.insert(mapping[roomName], tonumber(floorNumber))
            end
        end
    end
    return mapping
end

-- Generate the GymStructureJSON
function GymStructureIntegration:GenerateGymStructureJSON()
    print("Generating GymStructureJSON...")
    local structure = self:AnalyzeGymStructure(false)

	if structure then
		local jsonString = HttpService:JSONEncode(structure)

		local gymStructureJSON = ServerStorage:FindFirstChild("GymStructureJSON")
        if gymStructureJSON then gymStructureJSON:Destroy() end
		
		local newGymStructureJSON = Instance.new("StringValue")
		newGymStructureJSON.Name = "GymStructureJSON"
		newGymStructureJSON.Value = jsonString
		newGymStructureJSON.Parent = ServerStorage
        print("GymStructureJSON generated.")
    end
    return true
end

function GymStructureIntegration:AnalyzeGymStructure(verbose)
	print("Analyzing Gym Structure...")
	local gymParts = workspace:FindFirstChild("GymParts")
	if not gymParts then
		warn("GymStructureIntegration: GymParts folder not found in workspace.")
		return nil
	end
	local structure = processGymParts(gymParts)
    GenerateReport(structure)
	print("Gym Structure analysis finished.")
	return structure
end
