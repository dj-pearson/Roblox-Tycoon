--[[
    BuyTileHitboxGenerator.server.luau - 
    
    Automatically generates and updates hitboxes for BuyTiles based on the physical models.
    Hitboxes are essential for tile purchasing, but creating them manually is tedious.
    This script:
    1. Identifies models that need hitboxes
    2. Generates appropriately sized hitboxes based on model dimensions
    3. Positions hitboxes correctly relative to the model
    4. Sets up proper attributes and collision settings
    5. Can update existing hitboxes to match model changes
    
    Usage: Run _G.GenerateHitboxes() from the command bar
    
    Author: Created April 20, 2025
]]

local ServerStorage = game:GetService("ServerStorage")

-- BuyTile hitbox configuration
local HITBOX_CONFIG = {
    transparency = 0.9,              -- Hitbox transparency (0.9 for debugging, 1.0 for production)
    marginSize = Vector3.new(2,1,2), -- Extra space around model
    minSize = Vector3.new(4,2,4),    -- Minimum hitbox size
    material = Enum.Material.SmoothPlastic,
    color = Color3.fromRGB(0, 162, 255),
    collideWithPlayer = true,        -- Should hitbox collide with players
    canCollide = true,               -- Should hitbox collide with other objects
    anchored = true,                 -- Hitbox should be anchored
    castShadow = false,              -- Hitbox should not cast shadows
    offsetY = -0.5,                  -- Vertical offset from model center
    showDebugBoxes = true            -- Show semi-transparent hitboxes for debugging
}

-- Statistics for reporting
local stats = {
    modelsFound = 0,
    hitboxesCreated = 0,
    hitboxesUpdated = 0,
    hitboxesDeleted = 0,
    skipped = 0,
    errors = 0
}

-- Get all models in a tycoon or folder that need hitboxes
local function GetModelsThatNeedHitboxes(parent)
    local models = {}
    
    -- Check if parent itself needs a hitbox
    if (parent:IsA("Model") or parent:IsA("BasePart")) and 
       parent:GetAttribute("TileType") then
        table.insert(models, parent)
    end
    
    -- Iterate through all descendants
    for _, child in ipairs(parent:GetDescendants()) do
        -- Check if it's a model with TileType attribute
        if (child:IsA("Model") or child:IsA("BasePart")) and 
           child:GetAttribute("TileType") then
            
            -- Check if it already has a proper hitbox
            local existingHitbox = child:FindFirstChild("Hitbox")
            if not existingHitbox then
                table.insert(models, child)
            elseif existingHitbox and not existingHitbox:GetAttribute("HitboxGenerated") then
                -- Flag hitbox for update if it wasn't generated by this system
                table.insert(models, child)
            end
        end
    end
    
    return models
end

-- Create or update a hitbox for a model
local function CreateHitbox(model)
    stats.modelsFound += 1
    
    -- Get the model's tile type
    local tileType = model:GetAttribute("TileType")
    if not tileType then
        warn("BuyTileHitboxGenerator: Model " .. model.Name .. " has no TileType attribute")
        stats.errors += 1
        return nil
    end
    
    -- Check for existing hitbox
    local existingHitbox = model:FindFirstChild("Hitbox")
    local isUpdating = existingHitbox ~= nil
    
    -- Create a new hitbox or use existing one
    local hitbox
    if isUpdating then
        hitbox = existingHitbox
        stats.hitboxesUpdated += 1
    else
        hitbox = Instance.new("Part")
        hitbox.Name = "Hitbox"
        stats.hitboxesCreated += 1
    end
    
    -- Configure hitbox properties
    hitbox.Transparency = HITBOX_CONFIG.showDebugBoxes and HITBOX_CONFIG.transparency or 1.0
    hitbox.CanCollide = HITBOX_CONFIG.canCollide
    hitbox.Anchored = HITBOX_CONFIG.anchored
    hitbox.CastShadow = HITBOX_CONFIG.castShadow
    hitbox.Material = HITBOX_CONFIG.material
    hitbox.Color = HITBOX_CONFIG.color
    hitbox:SetAttribute("HitboxGenerated", true)
    hitbox:SetAttribute("TileType", tileType)
    hitbox:SetAttribute("GeneratedTime", os.time())
    
    -- Calculate bounds and set size/position
    if model:IsA("Model") then
        -- For models with a PrimaryPart
        if model.PrimaryPart then
            local primaryCFrame = model:GetPivot()
            local modelSize = model:GetExtentsSize()
            
            -- Ensure minimum size
            local sizeX = math.max(modelSize.X, HITBOX_CONFIG.minSize.X)
            local sizeY = math.max(modelSize.Y, HITBOX_CONFIG.minSize.Y)
            local sizeZ = math.max(modelSize.Z, HITBOX_CONFIG.minSize.Z)
            
            -- Apply margins
            hitbox.Size = Vector3.new(sizeX, sizeY, sizeZ) + HITBOX_CONFIG.marginSize
            
            -- Position at model's pivot with offset
            local offset = Vector3.new(0, HITBOX_CONFIG.offsetY, 0)
            hitbox.CFrame = primaryCFrame + offset
        else
            -- For models without PrimaryPart, calculate bounds
            local minBound = Vector3.new(math.huge, math.huge, math.huge)
            local maxBound = Vector3.new(-math.huge, -math.huge, -math.huge)
            local hasParts = false
            
            for _, part in pairs(model:GetDescendants()) do
                if part:IsA("BasePart") then
                    hasParts = true
                    local partSize = part.Size
                    local partPos = part.Position
                    
                    -- Update bounds
                    minBound = Vector3.new(
                        math.min(minBound.X, partPos.X - partSize.X/2),
                        math.min(minBound.Y, partPos.Y - partSize.Y/2),
                        math.min(minBound.Z, partPos.Z - partSize.Z/2)
                    )
                    
                    maxBound = Vector3.new(
                        math.max(maxBound.X, partPos.X + partSize.X/2),
                        math.max(maxBound.Y, partPos.Y + partSize.Y/2),
                        math.max(maxBound.Z, partPos.Z + partSize.Z/2)
                    )
                end
            end
            
            if not hasParts then
                warn("BuyTileHitboxGenerator: Model " .. model.Name .. " has no BaseParts")
                stats.errors += 1
                return nil
            end
            
            -- Calculate size and position
            local size = maxBound - minBound
            local position = minBound + size/2
            
            -- Ensure minimum size
            local sizeX = math.max(size.X, HITBOX_CONFIG.minSize.X)
            local sizeY = math.max(size.Y, HITBOX_CONFIG.minSize.Y)
            local sizeZ = math.max(size.Z, HITBOX_CONFIG.minSize.Z)
            
            -- Apply margins
            hitbox.Size = Vector3.new(sizeX, sizeY, sizeZ) + HITBOX_CONFIG.marginSize
            
            -- Position at center of bounds with offset
            local offset = Vector3.new(0, HITBOX_CONFIG.offsetY, 0)
            hitbox.CFrame = CFrame.new(position) + offset
        end
    elseif model:IsA("BasePart") then
        -- For individual parts
        local partSize = model.Size
        local partPos = model.Position
        
        -- Ensure minimum size
        local sizeX = math.max(partSize.X, HITBOX_CONFIG.minSize.X)
        local sizeY = math.max(partSize.Y, HITBOX_CONFIG.minSize.Y)
        local sizeZ = math.max(partSize.Z, HITBOX_CONFIG.minSize.Z)
        
        -- Apply margins
        hitbox.Size = Vector3.new(sizeX, sizeY, sizeZ) + HITBOX_CONFIG.marginSize
        
        -- Position at part center with offset
        local offset = Vector3.new(0, HITBOX_CONFIG.offsetY, 0)
        hitbox.CFrame = CFrame.new(partPos) + offset
    else
        warn("BuyTileHitboxGenerator: Object " .. model.Name .. " is not a Model or BasePart")
        stats.errors += 1
        return nil
    end
    
    -- Apply collision filter if needed
    if not HITBOX_CONFIG.collideWithPlayer then
        hitbox.CollisionGroup = "BuyTileHitboxes"
    end
    
    -- Create a proximity prompt if it doesn't exist already
    local proximityPrompt = hitbox:FindFirstChildOfClass("ProximityPrompt")
    if not proximityPrompt then
        local prompt = Instance.new("ProximityPrompt")
        prompt.Name = "BuyPrompt"
        prompt.ActionText = "Buy"
        prompt.ObjectText = model:GetAttribute("Description") or model.Name
        prompt.MaxActivationDistance = 10
        prompt.Parent = hitbox
    end
    
    -- Set parent if this is a new hitbox
    if not isUpdating then
        hitbox.Parent = model
    end
    
    return hitbox
end

-- Create hitboxes for all models in the workspace
local function GenerateAllHitboxes()
    print("BuyTileHitboxGenerator: Starting hitbox generation...")
    
    -- Reset statistics
    for key, _ in pairs(stats) do
        stats[key] = 0
    end
    
    -- Find all tycoons in the workspace
    local tycoons = {}
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            if string.find(child.Name, "Tycoon") or 
               string.find(child.Name, "Gym") then
                table.insert(tycoons, child)
            end
        end
    end
    
    -- Process all tycoons
    for _, tycoon in ipairs(tycoons) do
        print("BuyTileHitboxGenerator: Processing " .. tycoon.Name)
        
        -- Get models that need hitboxes
        local models = GetModelsThatNeedHitboxes(tycoon)
        
        -- Create hitboxes
        for _, model in ipairs(models) do
            local hitbox = CreateHitbox(model)
            if hitbox then
                print("  - Created/updated hitbox for " .. model.Name)
            end
        end
    end
    
    -- Process GymParts folder separately if it exists
    local gymParts = workspace:FindFirstChild("GymParts")
    if gymParts then
        print("BuyTileHitboxGenerator: Processing GymParts folder")
        
        -- Get models that need hitboxes
        local models = GetModelsThatNeedHitboxes(gymParts)
        
        -- Create hitboxes
        for _, model in ipairs(models) do
            local hitbox = CreateHitbox(model)
            if hitbox then
                print("  - Created/updated hitbox for " .. model.Name)
            end
        end
    end
    
    -- Report statistics
    print("\nBuyTileHitboxGenerator: Process complete!")
    print("Models found: " .. stats.modelsFound)
    print("Hitboxes created: " .. stats.hitboxesCreated)
    print("Hitboxes updated: " .. stats.hitboxesUpdated)
    print("Skipped: " .. stats.skipped)
    print("Errors: " .. stats.errors)
    
    return stats
end

-- Function to update hitbox configuration
local function SetHitboxConfig(config)
    -- Update config with provided values
    for key, value in pairs(config) do
        if HITBOX_CONFIG[key] ~= nil then
            HITBOX_CONFIG[key] = value
        else
            warn("BuyTileHitboxGenerator: Unknown config option: " .. key)
        end
    end
    
    print("BuyTileHitboxGenerator: Configuration updated")
    return HITBOX_CONFIG
end

-- Export functions for command line access
_G.GenerateHitboxes = function()
    return GenerateAllHitboxes()
end

_G.SetHitboxConfig = function(config)
    return SetHitboxConfig(config)
end

-- Return module
return {
    GenerateAllHitboxes = GenerateAllHitboxes,
    SetHitboxConfig = SetHitboxConfig,
    CreateHitbox = CreateHitbox
}