			<Item class="Script" referent="RBXA487D0236BFC48C885DBF76F9C5D8793">
				<Properties>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Operator</string>
					<token name="RunContext">0</token>
					<string name="ScriptGuid">{0C711303-8A2C-4E52-8ADD-A3D3E497091A}</string>
					<ProtectedString name="Source"><![CDATA[--Tofwap brand door, check out this set for more http://www.roblox.com/my/sets.aspx?id=47308
Par=script.Parent
Set1=Par.Set1
Set2=Par.Set2
Contam=false
function Seal(Directory)
	Number=0
	Dir=Directory:GetChildren()
	while Number<=114 do
		wait(.01)
		Number=Number+1
		for i=1,#Dir do
			if(Dir[i].Name=="First")and(Number<=104)then
				Dir[i].CFrame=Dir[i].CFrame+Vector3.new(0,0.1,0)
			end
			if(Dir[i].Name=="Second")and(Number<=109)and(Number>=5)then
				Dir[i].CFrame=Dir[i].CFrame+Vector3.new(0,0.1,0)
			end
			if(Dir[i].Name=="Third")and(Number>=10)then
				Dir[i].CFrame=Dir[i].CFrame+Vector3.new(0,0.1,0)				
			end
		end
	end
end
function Open(Directory)
	Number=0
	Dir=Directory:GetChildren()
	while Number<=114 do
		wait(.01)
		Number=Number+1
		for i=1,#Dir do
			if(Dir[i].Name=="First")and(Number<=104)then
				Dir[i].CFrame=Dir[i].CFrame-Vector3.new(0,0.1,0)
			end
			if(Dir[i].Name=="Second")and(Number<=109)and(Number>=5)then
				Dir[i].CFrame=Dir[i].CFrame-Vector3.new(0,0.1,0)
			end
			if(Dir[i].Name=="Third")and(Number>=10)then
				Dir[i].CFrame=Dir[i].CFrame-Vector3.new(0,0.1,0)				
			end
		end
	end
	wait(1)--how long is door open
end
function Smoke()
	Par.Smoke1.S.Enabled=true
	Par.Smoke2.S.Enabled=true
	wait(3)
	Par.Smoke1.S.Enabled=false
	Par.Smoke2.S.Enabled=false
	wait(4)
end
Par.Enter1.CD.MouseClick:connect(function()
	if(Contam==false)then
		Contam=true
		Open(Set1)
		Seal(Set1)
		Smoke()
		Open(Set2)
		Seal(Set2)
		Contam=false
	end
end)
Par.Enter2.CD.MouseClick:connect(function()
	if(Contam==false)then
		Contam=true
		Open(Set2)
		Seal(Set2)
		Smoke()
		Open(Set1)
		Seal(Set1)
		Contam=false
	end
end)
]]></ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
					<BinaryString name="Tags"></BinaryString>
				</Properties>
			</Item>
