# Save the main script
$srcDir = Join-Path $tempDir "src"
if (-Not (Test-Path $srcDir)) {
    New-Item -ItemType Directory -Path $srcDir -Force | Out-Null
}
$mainScriptPath = Join-Path $srcDir "init.server.lua"
Set-Content -Path $mainScriptPath -Value $mainScript

# Create a plugin specific structure
$pluginDir = Join-Path $srcDir "Plugin"
if (-Not (Test-Path $pluginDir)) {
    New-Item -ItemType Directory -Path $pluginDir -Force | Out-Null
}

# Copy all files from the source folder to the plugin directory
Copy-Item -Path "$sourceFolder\*" -Destination $pluginDir -Recurse -Force

# Update the Argon project file to mark this as a plugin
$argonTomlPath = Join-Path $tempDir "argon.toml"
if (Test-Path $argonTomlPath) {
    $argonToml = Get-Content -Path $argonTomlPath -Raw
    $argonToml = $argonToml + "`n`n[plugin]`nenabled = true`n"
    Set-Content -Path $argonTomlPath -Value $argonToml
    Write-Host "Updated Argon project configuration for plugin." -ForegroundColor Green
}

# Build the plugin using Argon
