{
  "name": "DataStore Manager Pro",
  "tree": {
    "$className": "Plugin",
    "$properties": {
      "RunContext": "Server"
    },
    "DataStore Plugin": {
      "$path": "DataStore Plugin",
      "$ignoreUnknownInstances": true,
      "$ignoreFiles": [
        "*.png",
        "Backups/*",
        "*.backup*"
      ]
    }
  }
}