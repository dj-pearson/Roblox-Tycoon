{
    "IDX.aI.enableInlineCompletion": true,
    "IDX.aI.enableCodebaseIndexing": true,
    // Lua/Luau settings
    "files.associations": {
        "*.luau": "lua",
        "*.lua": "lua"
    },
    // Selene linting settings
    "selene.exe": "selene",
    "selene.lintOnSave": true,
    "selene.lintActiveFileOnly": false,
    // Roblox LSP Settings
    "robloxLsp.diagnostics.enable": true,
    "robloxLsp.diagnostics.severity": {
        "unexpect-dots": "Error"
    },
    // General editor settings
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit"
    },
    // Exclude temporary files from file watching
    "files.watcherExclude": {
        "**/EventBridge_copy.luau": true,
        "**/EventBridge_fixed.luau": true,
        "**/temp_fix.lua": true
    },
    "robloxLsp.diagnostics.workspaceDelay": 30000
}